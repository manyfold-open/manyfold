# Self-hosted stack configuration (docker-compose.selfhost.yml).
# Copy to .env next to the compose file, fill the two required values, then:
#   docker compose -f docker-compose.selfhost.yml up -d --build

# REQUIRED — long-term encryption master key for stored credentials.
# Generate with: openssl rand -base64 32
# Keep it with your database backups: losing it makes encrypted rows useless.
MF_API_CRYPTO_KEY=

# REQUIRED — one-time token for the first-run /setup flow in the admin app.
MF_AUTH_SETUP_TOKEN=

# Postgres superuser password inside the stack (default: manyfold).
#MF_SELFHOST_PG_PASSWORD=manyfold

# Host ports.
#MF_SELFHOST_API_PORT=2222
#MF_SELFHOST_WEB_PORT=3002
#MF_SELFHOST_ADMIN_PORT=3001

# URLs browsers use to reach each app. The API URL is baked into the web and
# admin bundles at build time — change these when serving beyond localhost,
# then rebuild (docker compose ... up -d --build).
#MF_SELFHOST_API_URL=http://localhost:2222/api
#MF_SELFHOST_PUBLIC_API_URL=http://localhost:2222
#MF_SELFHOST_WEB_URL=http://localhost:3002
#MF_SELFHOST_ADMIN_URL=http://localhost:3001

# Domains allowed as absolute post-sign-in redirect targets (comma-separated
# suffixes). Empty (default) = same-origin paths only; set to your domain when
# agent dashboards live on sibling subdomains.
#MF_SELFHOST_DASHBOARD_SUFFIXES=

# Origins the API accepts cross-origin requests from (comma-separated).
# Empty (default) reflects any origin — fine on localhost; pin to the exact
# web + admin origins when the API is reachable from elsewhere.
#MF_SELFHOST_CORS_ORIGIN=
