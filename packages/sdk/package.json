{
    "name": "@manyfold/sdk",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "check": "tsc --noEmit && tsc --project tsconfig.tests.json",
        "test": "node --import tsx --test test/*.test.ts"
    },
    "dependencies": {
        "@manyfold/shared": "workspace:*"
    },
    "devDependencies": {
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
