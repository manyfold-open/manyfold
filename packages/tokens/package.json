{
    "name": "@manyfold/tokens",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "check": "tsc --noEmit && tsc --project tsconfig.scripts.json",
        "test": "node --import tsx --test test/*.test.ts",
        "tokens:drift": "node --import tsx scripts/drift.ts",
        "tokens:verify": "node --import tsx scripts/verify.ts"
    },
    "devDependencies": {
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
