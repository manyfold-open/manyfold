{
    "name": "@manyfold/sprites",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "check": "tsc --noEmit && tsc --project tsconfig.tests.json",
        "test": "node --import tsx --test test/*.test.ts",
        "test:live": "node --import tsx --test test/live/*.test.ts"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/ws": "^8.5.13",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
