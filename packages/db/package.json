{
    "name": "@manyfold/db",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./schema": {
            "types": "./dist/schema/index.d.ts",
            "default": "./dist/schema/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "check": "tsc --noEmit"
    },
    "dependencies": {
        "drizzle-orm": "^0.36.4",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "typescript": "^5.6.3"
    }
}
