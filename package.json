{
    "name": "manyfold",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "turbo dev",
        "dev:api": "turbo run build --filter='@manyfold/api^...' && pnpm --filter @manyfold/api start:dev",
        "dev:admin": "pnpm --filter @manyfold/admin dev",
        "dev:web": "pnpm --filter @manyfold/web dev",
        "dev:cli": "pnpm --filter @manyfold/cli dev",
        "build": "turbo build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "knip": "knip",
        "format": "prettier --write . && eslint . --fix",
        "format:check": "prettier --check .",
        "migrations:check": "node --test scripts/check-migration-ownership.test.mjs && node scripts/check-migration-ownership.mjs",
        "sealed-env:check": "node --test scripts/test-sealed-env.test.mjs",
        "changeset-presence:check": "node --test scripts/check-changeset-presence.test.mjs && node scripts/check-changeset-presence.mjs",
        "cli-content:check": "pnpm --filter @manyfold/docs check:cli-content",
        "social-card:check": "pnpm --filter @manyfold/web exec tsx scripts/og/check.ts",
        "check": "turbo check",
        "test": "turbo test",
        "db:generate": "pnpm --filter @manyfold/api db:generate",
        "db:migrate": "pnpm --filter @manyfold/api db:migrate",
        "db:studio": "pnpm --filter @manyfold/api db:studio",
        "changeset": "changeset",
        "changeset:status": "changeset status",
        "changeset:version": "changeset version",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.31.0",
        "@changesets/config": "^3.1.4",
        "@changesets/parse": "^0.4.3",
        "@eslint/js": "^9.17.0",
        "@manypkg/get-packages": "^1.1.3",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "knip": "^5.88.1",
        "playwright": "^1.60.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "turbo": "^2.8.7",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.18.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@nestjs/core",
            "better-sqlite3",
            "esbuild",
            "node-pty",
            "protobufjs",
            "sharp"
        ],
        "overrides": {
            "fastify": "5.11.3",
            "playwright": "1.60.0",
            "tsx": "4.21.0"
        }
    },
    "packageManager": "pnpm@10.29.3",
    "engines": {
        "node": ">=20"
    }
}
