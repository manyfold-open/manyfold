{
    "name": "@manyfold/api",
    "version": "0.51.5",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "dev": "nest start --watch",
        "check": "tsc --noEmit && tsc --project tsconfig.tests.json",
        "test": "node ../../scripts/test-sealed-env.mjs -- node --import tsx --test test/*.test.ts",
        "test:ci": "node ../../scripts/test-sealed-env.mjs -- node --import tsx --test --test-shard=${TEST_SHARD:-1/1} test/*.test.ts",
        "test:pg:audit": "tsx scripts/run-pg-audit.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
        "db:migrate:prod": "node dist/db/migrate.js",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1039.0",
        "@aws-sdk/lib-storage": "^3.1039.0",
        "@discordjs/core": "^2.4.0",
        "@discordjs/rest": "^2.6.1",
        "@discordjs/ws": "^2.0.4",
        "@fastify/multipart": "^10.0.0",
        "@fastify/websocket": "^11.2.0",
        "@kubernetes/client-node": "^1.4.0",
        "@larksuiteoapi/node-sdk": "^1.62.1",
        "@manyfold/a2a": "workspace:*",
        "@manyfold/db": "workspace:*",
        "@manyfold/external-providers": "workspace:*",
        "@manyfold/k8s-exec-core": "workspace:*",
        "@manyfold/shared": "workspace:*",
        "@manyfold/sprites": "workspace:*",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.0",
        "@nestjs/schedule": "^6.1.3",
        "@node-rs/argon2": "^2.0.2",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/api-logs": "^0.216.0",
        "@opentelemetry/auto-instrumentations-node": "^0.74.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.216.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
        "@opentelemetry/instrumentation-fastify": "^0.57.0",
        "@opentelemetry/instrumentation-nestjs-core": "^0.62.0",
        "@opentelemetry/resources": "^2.7.1",
        "@opentelemetry/sdk-logs": "^0.216.0",
        "@opentelemetry/sdk-node": "^0.216.0",
        "@opentelemetry/sdk-trace-base": "^2.7.1",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "@sentry/node": "^10.69.0",
        "@sentry/opentelemetry": "^10.69.0",
        "better-sqlite3": "^11.7.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "discord-api-types": "^0.38.47",
        "drizzle-orm": "^0.36.4",
        "fflate": "^0.8.3",
        "jose": "^6.2.3",
        "marked": "^17.0.6",
        "mime-types": "^3.0.2",
        "nodemailer": "^7.0.9",
        "postgres": "^3.4.5",
        "reflect-metadata": "^0.2.2",
        "rrule": "^2.8.1",
        "rxjs": "^7.8.1",
        "smol-toml": "^1.7.0",
        "tsconfig-paths": "^4.2.0",
        "ws": "^8.20.0",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.1.0",
        "@types/better-sqlite3": "^7.6.12",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^7.0.4",
        "@types/ws": "^8.5.13",
        "dotenv": "^16.6.1",
        "drizzle-kit": "^0.28.1",
        "fastify": "^5.8.4",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "undici": "^6.25.0"
    }
}
