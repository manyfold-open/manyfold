PORT=2222
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manyfold
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# 32-byte base64 key used by CryptoService to encrypt sprites.dev tokens +
# per-agent credentials and login provider secrets at rest. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_CRYPTO_KEY=replace_me_with_32_byte_base64
# Optional decrypt-only legacy key during a version-0 -> version-1 rotation.
# Keep it configured until no encrypted DB value still records key version 0.
API_CRYPTO_KEY_V0=
# Required by POST /api/auth/setup before the first login provider is saved.
AUTH_SETUP_TOKEN=replace_me_with_random_setup_token

# Emergency admin overrides. Normal bootstrap admin emails are configured via
# the first-run setup page and stored in app_settings.
ADMIN_EMAILS=you@example.com
ADMIN_USER_IDS=

# Web app base URL for Checkout / Portal success + cancel + return redirects,
# and the default landing origin for the native OAuth callback (#session=).
WEB_BASE_URL=http://localhost:3002
# Admin app base URL. Required for admin-initiated Google/OIDC login to return
# to the admin app (its origin is allowlisted for the OAuth callback redirect);
# without it the callback falls back to the web app.
MF_ADMIN_URL=http://localhost:3001

# NetMind login is configured at runtime in the admin app (Settings → Login
# provider), like Google/OIDC — no env var. Point its "NetMind auth API" at the
# same NetMind environment NarraNexus uses so loginTokens are interchangeable.

# Optional GitHub token for Skills discovery. Without this, discovery uses
# anonymous GitHub API limits and can be rate-limited during repeated testing.
GITHUB_TOKEN=

# --- GitHub App (account-level GitHub connections injected into agents) ---
# A single platform GitHub App. Users install it (picking repos) to link a GitHub
# connection; the API mints short-lived (~1h) installation tokens on demand from
# the private key and injects them as GH_TOKEN/GITHUB_TOKEN into their agents.
# When GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY are unset, GitHub connections are
# disabled (the endpoints return 503); Cloudflare connections still work.
# The App's "Setup URL" (post-install redirect) MUST be:
#   {PUBLIC_API_BASE_URL}/api/connections/github/callback
# Numeric App ID (GitHub → App settings → "App ID").
GITHUB_APP_ID=
# The App's URL slug from github.com/apps/<slug> (used to build the install URL).
GITHUB_APP_SLUG=
# Base64 of the App private key .pem (App settings → "Private keys"). Encode w/o
# newlines so it survives .env / `fly secrets`:
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# --- k8s runtime (openclaw / hermes / native CLI agents) ---
# Absolute path to a kubeconfig file that grants access to the target cluster.
# When unset, the k8s-runtime endpoints return 503; sprites endpoints still work.
KUBECONFIG=
# Control-plane exec gateway inside the cluster (see apps/k8s-gateway).
# Both are only required to run agents on the k8s runtime: when unset the API
# still boots and k8s pod-exec fails with a NOT_CONFIGURED error.
MF_K8S_GATEWAY_URL=
MF_K8S_GATEWAY_TOKEN=
# Wildcard DNS suffix used for per-agent ingress hosts (<agentId>.<suffix>).
K8S_INGRESS_HOST_SUFFIX=18.135.81.53.nip.io
# StorageClass used for per-agent PVCs.
K8S_STORAGE_CLASS=standard
# Container images for the k8s-runtime frameworks.
K8S_IMAGE_OPENCLAW=openclaw:latest
K8S_IMAGE_HERMES=hermes:latest
# Optional k8s runtime images for CLI-backed frameworks (selected at agent
# create time via `runtime: 'k8s'`). If unset, k8s path is disabled for these.
K8S_IMAGE_CLAUDE_CODE=claude-code:latest
K8S_IMAGE_CODEX=codex:latest
K8S_IMAGE_GEMINI_CLI=gemini-cli:latest
# Wall-clock budget for the sync create flow before rollback + 504.
K8S_CREATE_TIMEOUT_MS=120000

# --- workspace backups (S3-compatible storage) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=agent-workspace-backups
BACKUP_RETENTION_COUNT=20

# --- chat uploads (files attached to external/Dify agent chats; S3-compatible) ---
# PROD MUST set these: the api runs on multiple machines, so transient upload
# bytes must live in shared storage, not per-machine disk.
CHAT_UPLOAD_S3_ENDPOINT=
CHAT_UPLOAD_S3_REGION=us-east-1
CHAT_UPLOAD_S3_BUCKET=
CHAT_UPLOAD_S3_ACCESS_KEY_ID=
CHAT_UPLOAD_S3_SECRET_ACCESS_KEY=
CHAT_UPLOAD_S3_FORCE_PATH_STYLE=true
CHAT_UPLOAD_S3_PREFIX=chat-uploads
# Local dev only: allow falling back to per-machine temp disk when no S3 is set.
# Leave unset/false in prod so misconfiguration fails closed instead of silently
# storing uploads on one machine that the next request can't read.
CHAT_UPLOAD_ALLOW_DISK=false

# --- channels (external chat platforms — Lark, etc.) ---
# When false, /api/channels and /api/channels/hooks/* return 404.
CHANNELS_ENABLED=true
# Public URL the client copies into the external platform's webhook config.
# Falls back to http://localhost:${PORT}; set this in prod.
# Origin only, WITHOUT the /api prefix — consumers (channels webhooks,
# runtime reports, agent MF_API_URL injection) append it themselves.
PUBLIC_API_BASE_URL=http://localhost:2222
# Deployment environment exposed to agent runtimes (staging|production|local).
# Read as-is from the environment — no fallback derivation.
MF_DEPLOY_ENV=local

# Default Open Platform for old Lark-compatible channel configs that omit
# config.appRegion. New channels choose Feishu or Lark per channel.
LARK_APP_REGION=feishu
# Legacy fallback for old deployments; prefer per-channel config.appRegion.
# LARK_OPEN_BASE_URL=https://open.feishu.cn
# Days to keep channel_deliveries rows (message log + retry queue). Default 30.
# Values below 7 clamp to 7 (inbound webhook dedup needs the original row to
# outlive provider redelivery windows); 0 disables pruning.
# CHANNEL_DELIVERY_RETENTION_DAYS=30

# Chat history retention sweep: prunes chat_messages older than the user's
# plan window (plans.message_history_retention_days; NULL = keep forever) and
# clears raw payloads on expired chat_message_sources rows. Daily by default.
# CHAT_RETENTION_ENABLED=false        # kill switch
# CHAT_RETENTION_INTERVAL_MS=86400000 # floor 5 min
# CHAT_RETENTION_MAX_DELETES_PER_RUN=50000
# CHAT_RETENTION_DRY_RUN=1            # log per-user counts, delete nothing
# The same tick also emits chat.stream_log.size (estimated rows + total bytes
# from the catalog, no table scan) every run; the kill switch above silences it
# together with the sweep.

# Post-terminal stream-log compaction. Deletes only the token/thinking rows of
# assistant turns whose newest stream event is a done/error older than this many
# days, never touching tool/replace/terminal rows or a turn whose content blocks
# were truncated in memory. Unset/0/garbage = entirely off (the default);
# values below 7 clamp UP to 7, because a recently finished turn can still be
# resumed by an SSE client or replayed on cold reload. Compacted turns lose
# token-level replay — their content lives in chat_messages.content_blocks_json.
# MF_STREAM_LOG_COMPACT_AFTER_DAYS=30

# --- chat streaming and turn adoption ---
# Contiguous token/thinking emits sharing a source key coalesce into one
# chat_stream_events row inside this window (an idle stream still gets a
# leading-edge immediate write, so first-token latency is unaffected).
# 0 = legacy per-event rows — the rollback lever if coalescing misbehaves.
# MF_CHAT_STREAM_FLUSH_MS=120
# An adopted turn that was still generating is re-read until its transcript
# turns terminal instead of being failed; this caps how long the adopter
# holds that lease on a pathologically long turn.
# MF_TURN_ADOPT_REPOLL_MS=600000

# --- observability (Axiom + OpenTelemetry) ---
# When AXIOM_API_TOKEN is empty, OTel is a no-op (zero overhead, no exports).
# Local runs also stay disabled by default so they cannot write to prod datasets.
AXIOM_API_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
AXIOM_DATASET=manyfold-otel
OTEL_SERVICE_NAME=manyfold-api

# --- error tracking (Sentry) ---
# When SENTRY_DSN is empty, Sentry is a no-op (nothing is initialised or sent).
# Unlike Axiom this is not gated on FLY_APP_NAME: setting a DSN locally is
# deliberate and those events land under environment=local.
SENTRY_DSN=
# Share of traces forwarded to Sentry. Axiom always keeps 100% regardless.
# Defaults to 0.25 when MF_DEPLOY_ENV=production, otherwise 1.
# SENTRY_TRACES_SAMPLE_RATE=0.25

# Plan assigned to newly created accounts (default: free). Self-hosted
# deployments set self_hosted (seeded unlimited tier); the id must exist in
# the plans table or account creation fails on the foreign key. Applies at
# account creation only — on a deployment with no billing module, accounts
# still on 'free' are moved here once, on the next API start.
#MF_DEFAULT_PLAN_ID=
