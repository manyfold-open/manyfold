---
import BaseLayout from '@/layouts/BaseLayout.astro'
import DocArticle from '@/components/DocArticle.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import {
    entrySlug,
    filterDocsByLocale,
    getUi,
    localePath,
    nonDefaultLocales,
    type Locale
} from '@/lib/i18n'

export async function getStaticPaths() {
    const allEntries = await getCollection('docs')

    return nonDefaultLocales.flatMap((locale) =>
        filterDocsByLocale(allEntries, locale).map((entry) => ({
            params: { locale, slug: entrySlug(entry) },
            props: { entry, locale }
        }))
    )
}

const { entry, locale } = Astro.props as {
    entry: CollectionEntry<'docs'>
    locale: Locale
}
const entries = filterDocsByLocale(await getCollection('docs'), locale)
const breadcrumbs =
    entrySlug(entry) === 'getting-started'
        ? undefined
        : [
              {
                  name: getUi(locale).docs,
                  href: localePath(locale, '/docs/getting-started/')
              },
              { name: entry.data.title }
          ]
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    locale={locale}
    type="article"
    breadcrumbs={breadcrumbs}
>
    <DocArticle entry={entry} entries={entries} locale={locale} />
</BaseLayout>
