---
import BaseLayout from '@/layouts/BaseLayout.astro'
import DocArticle from '@/components/DocArticle.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import {
    entrySlug,
    filterDocsByLocale,
    getUi,
    groupKeyForTitle,
    groupTitleFor,
    subgroupFor,
    localePath,
    nonDefaultLocales,
    type Locale
} from '@/lib/i18n'

export async function getStaticPaths() {
    const allEntries = await getCollection('docs')

    return nonDefaultLocales.flatMap((locale) =>
        filterDocsByLocale(allEntries, locale).map((entry) => ({
            params: { locale, slug: entrySlug(entry) },
            props: { entry, locale }
        }))
    )
}

const { entry, locale } = Astro.props as {
    entry: CollectionEntry<'docs'>
    locale: Locale
}
const entries = filterDocsByLocale(await getCollection('docs'), locale)
// Four levels where the tree has four. The section and the tier below it both
// point at their heading in the dashboard's grouped index, which is a real URL:
// an intermediate BreadcrumbList item with no `item` is what Google drops a
// trail over.
const group = groupTitleFor(entry, locale)
const groupAnchor = group && groupKeyForTitle(group, locale)
const subgroup = subgroupFor(entry, locale)
const breadcrumbs = [
    {
        name: getUi(locale).docs,
        href: localePath(locale, '/docs/')
    },
    ...(group && groupAnchor
        ? [{ name: group, href: localePath(locale, `/docs/#${groupAnchor}`) }]
        : []),
    ...(subgroup
        ? [
              {
                  name: subgroup.title,
                  href: localePath(locale, `/docs/#${subgroup.anchor}`)
              }
          ]
        : []),
    { name: entry.data.title }
]
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    locale={locale}
    type="article"
    articleType="TechArticle"
    breadcrumbs={breadcrumbs}
>
    <DocArticle entry={entry} entries={entries} locale={locale} />
</BaseLayout>
