---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getUi, type Locale } from '@/lib/i18n'

const locale: Locale = 'en'
const copy = getUi(locale)
---

<BaseLayout title={copy.statusTitle} description={copy.statusDescription} locale={locale}>
    <section class="docs-container docs-page-section">
        <header class="docs-page-header">
            <p class="docs-kicker">{copy.brandShort}</p>
            <h1 class="mt-3 text-h1">{copy.statusTitle}</h1>
            <p class="docs-copy mt-2">{copy.statusLead}</p>
        </header>

        <div
            class="bg-success-bg mt-6 flex max-w-2xl items-center gap-3 rounded-sm px-4 py-4"
            style="box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-success) 45%, transparent)"
        >
            <span class="bg-success inline-block h-3 w-3 rounded-full" aria-hidden="true"></span>
            <div>
                <div class="text-h3 text-success-strong">{copy.statusOk}</div>
                <div class="mt-1 text-ui text-muted">
                    {copy.statusComing}
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
