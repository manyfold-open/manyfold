---
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import SearchModal from '@/components/SearchModal.astro'
import SupportBubble from '@/components/SupportBubble.astro'
import {
    alternateLocalePath,
    getUi,
    localeOption,
    localePath,
    locales,
    type Locale
} from '@/lib/i18n'

interface Props {
    title: string
    description?: string
    locale?: Locale
    type?: 'website' | 'article'
    availableLocales?: Locale[]
    breadcrumbs?: { name: string; href?: string }[]
    hideSupportBubble?: boolean
    // Keep a page out of the index without keeping crawlers out of the
    // links on it. 404.astro is the only current caller: a soft-404 that
    // gets indexed competes with the real pages for the same queries.
    noindex?: boolean
    // Per-page social card, overriding the shared static one below. Docs pages
    // pass their generated card; everything else keeps the shared art.
    ogImage?: string
}

const {
    title,
    description,
    locale = 'en',
    type = 'website',
    availableLocales = locales,
    breadcrumbs = [],
    hideSupportBubble = false,
    noindex = false,
    ogImage: ogImageOverride
} = Astro.props
const fullTitle = title === 'Manyfold' ? title : `${title} — Manyfold`
const option = localeOption(locale)
const desc = description ?? getUi(locale).defaultDescription
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const llmsIndexUrl = new URL(
    localePath(locale, '/llms.txt'),
    Astro.site
).toString()
// Per-locale because the headline is baked into the art. Source and exporter
// live in apps/web/scripts/og, which also writes the PNGs into this app's
// public/social; `pnpm social-card:check` fails if these names, that app's
// copies and the exporter's POSTER_VERSION ever disagree.
const ogImage =
    ogImageOverride ??
    new URL(
        locale === 'zh'
            ? '/social/manyfold-og-zh-v3.png'
            : '/social/manyfold-og-v3.png',
        Astro.site
    ).toString()
const alternateLinks = availableLocales.map((alternateLocale) => ({
    href: new URL(
        alternateLocalePath(Astro.url.pathname, alternateLocale),
        Astro.site
    ).toString(),
    hreflang: localeOption(alternateLocale).locale,
    ogLocale: localeOption(alternateLocale).locale.replace('-', '_')
}))
const defaultAlternateLocale = availableLocales.includes('en') ? 'en' : locale
const xDefault = new URL(
    alternateLocalePath(Astro.url.pathname, defaultAlternateLocale),
    Astro.site
).toString()
const breadcrumbJsonLd =
    breadcrumbs.length >= 2
        ? JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: breadcrumbs.map((breadcrumb, index) => ({
                  '@type': 'ListItem',
                  position: index + 1,
                  name: breadcrumb.name,
                  ...(breadcrumb.href
                      ? {
                            item: new URL(
                                breadcrumb.href,
                                Astro.site
                            ).toString()
                        }
                      : {})
              }))
          }).replace(/</g, '\\u003c')
        : null
---

<!doctype html>
<html lang={option.locale} dir={option.direction}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>
            try {
                const t = localStorage.getItem('mf-theme')
                if (t === 'dark')
                    document.documentElement.setAttribute('data-theme', 'dark')
                else if (
                    !t &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches
                )
                    document.documentElement.setAttribute('data-theme', 'dark')
            } catch (e) {}
        </script>
        <!-- Microsoft YaHei ships only 400 and 700, so a CJK run at 500
             resolves to Regular and <strong> loses its only signal. Windows
             keeps 600, which maps to Bold; every other platform has a real
             Medium and gets the lighter 500. -->
        <script is:inline>
            if (/Windows/.test(navigator.userAgent))
                document.documentElement.setAttribute(
                    'data-cjk-weights',
                    'coarse'
                )
        </script>
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        {
            alternateLinks.map((link) => (
                <link rel="alternate" hreflang={link.hreflang} href={link.href} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={xDefault} />
        {/* Feed autodiscovery, site-wide. There is one feed and it is English
            only, so it needs no locale handling. Site-wide rather than on the
            changelog page because the changelog carried no reference to its own
            feed at all: the feed's only link anywhere was the dashboard's
            machine-readable block, and removing that block would have left it
            reachable only by guessing the URL. This is the mechanism a reader
            or a crawler is supposed to find it by, and it renders nothing. */}
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Manyfold changelog"
            href={new URL('/changelog/feed.xml', Astro.site).toString()}
        />
        <title>{fullTitle}</title>
        <meta name="description" content={desc} />
        <meta property="og:site_name" content="Manyfold" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={desc} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={type} />
        <meta property="og:locale" content={option.locale.replace('-', '_')} />
        {
            alternateLinks
                .filter((link) => link.ogLocale !== option.locale.replace('-', '_'))
                .map((link) => (
                    <meta property="og:locale:alternate" content={link.ogLocale} />
                ))
        }
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={getUi(locale).socialImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={desc} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={getUi(locale).socialImageAlt} />
        <meta name="theme-color" content="#dde0e3" />
        {
            breadcrumbJsonLd && (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={breadcrumbJsonLd}
                />
            )
        }
    </head>
    <body class="bg-app text-fg flex min-h-screen flex-col">
        <!--
            Agent-facing documentation index pointer, the first element in <body>.
            See docs-artifacts/edits-baselayout-agent-index.md. aria-hidden as well
            as sr-only, following fal: a screen reader user does not need a machine
            index announced ahead of the content on every single page. This is what
            an agent gets when it fetches the page URL instead of the .md twin.
        -->
        <blockquote class="sr-only" data-agent-docs-index="true" aria-hidden="true">
            <h2>Documentation Index</h2>
            <p>
                Fetch the complete documentation index at:{' '}
                <a href={localePath(locale, '/llms.txt')} tabindex="-1">
                    {llmsIndexUrl}
                </a>
            </p>
            <p>Use this file to discover all available pages before exploring further.</p>
        </blockquote>
        <Header locale={locale} availableLocales={availableLocales} />
        <main class="docs-main flex-1">
            <slot />
        </main>
        <Footer locale={locale} />
        <SearchModal locale={locale} />
        {!hideSupportBubble && <SupportBubble locale={locale} />}
        <script>
            // Page actions: Copy page and the dropdown. Copy fetches the .md
            // twin rather than serialising the DOM, so what lands on the
            // clipboard is the authored Markdown a model should read, not a
            // reconstruction of the rendered page. Falls back to the visible
            // article text only if the twin cannot be fetched.
            document
                .querySelectorAll<HTMLElement>('[data-page-actions]')
                .forEach((root) => {
                    const main = root.querySelector<HTMLButtonElement>('[data-copy-page]')
                    const toggle = root.querySelector<HTMLButtonElement>('[data-pa-toggle]')
                    const menu = root.querySelector<HTMLElement>('[data-pa-menu]')
                    const label = root.querySelector<HTMLElement>('[data-copy-label]')
                    const mdHref = root.dataset.md
                    const doneText = root.dataset.copied ?? 'Copied'

                    const closeMenu = () => {
                        menu?.setAttribute('hidden', '')
                        toggle?.setAttribute('aria-expanded', 'false')
                    }

                    toggle?.addEventListener('click', (event) => {
                        event.stopPropagation()
                        const open = menu?.hasAttribute('hidden')
                        if (open) {
                            menu?.removeAttribute('hidden')
                            toggle.setAttribute('aria-expanded', 'true')
                        } else {
                            closeMenu()
                        }
                    })
                    document.addEventListener('click', closeMenu)
                    document.addEventListener('keydown', (event) => {
                        if (event.key === 'Escape') closeMenu()
                    })

                    main?.addEventListener('click', async () => {
                        let text = ''
                        try {
                            if (mdHref) {
                                const res = await fetch(mdHref)
                                if (res.ok) text = await res.text()
                            }
                        } catch {
                            text = ''
                        }
                        if (!text) {
                            text =
                                document.querySelector<HTMLElement>('[data-copy-scope]')
                                    ?.innerText ?? ''
                        }
                        try {
                            await navigator.clipboard?.writeText(text)
                        } catch {
                            return
                        }
                        if (!label) return
                        const original = label.textContent
                        label.textContent = doneText
                        window.setTimeout(() => {
                            label.textContent = original
                        }, 1600)
                    })
                })
        </script>
        <script>
            // A heading anchor is a working link without this: clicking it sets
            // the hash. The script adds what fal's does on top, copying the
            // absolute URL, because the reason someone clicks a heading anchor
            // is to paste it somewhere. Replicate only moves the hash, which
            // leaves the reader to go and copy the address bar themselves.
            document.addEventListener('click', (event) => {
                const target = event.target as HTMLElement | null
                const anchor = target?.closest<HTMLAnchorElement>(
                    '.docs-heading-anchor'
                )
                if (!anchor) return
                const url = new URL(
                    anchor.getAttribute('href') ?? '',
                    window.location.href
                ).toString()
                navigator.clipboard?.writeText(url)
                anchor.classList.add('is-done')
                window.setTimeout(() => anchor.classList.remove('is-done'), 1300)
            })
        </script>
        <script>
            const ICON_COPY =
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>'
            const ICON_DONE =
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
            const LANG_LABEL: Record<string, string> = {
                sh: 'bash',
                shell: 'bash',
                bash: 'bash',
                zsh: 'bash',
                console: 'bash',
                js: 'javascript',
                ts: 'typescript',
                json: 'json',
                yaml: 'yaml',
                yml: 'yaml',
                toml: 'toml',
                http: 'http',
                text: '',
                plaintext: ''
            }
            document
                .querySelectorAll<HTMLElement>('[data-copy-scope] pre')
                .forEach((pre) => {
                    if (pre.closest('.docs-code')) return
                    const code = pre.querySelector('code')
                    if (!code) return

                    const raw = (pre.dataset.language || '').toLowerCase()
                    const lang = raw in LANG_LABEL ? LANG_LABEL[raw] : raw

                    const bar = document.createElement('div')
                    bar.className = 'docs-codebar'
                    const label = document.createElement('span')
                    label.className = 'docs-codebar-lang'
                    label.textContent = lang
                    bar.appendChild(label)

                    const btn = document.createElement('button')
                    btn.type = 'button'
                    btn.className = 'docs-copy-btn'
                    btn.setAttribute('aria-label', 'Copy code')
                    btn.innerHTML = ICON_COPY
                    btn.addEventListener('click', () => {
                        navigator.clipboard?.writeText(code.innerText)
                        btn.innerHTML = ICON_DONE
                        btn.classList.add('is-done')
                        setTimeout(() => {
                            btn.innerHTML = ICON_COPY
                            btn.classList.remove('is-done')
                        }, 1300)
                    })
                    bar.appendChild(btn)

                    const fig = document.createElement('figure')
                    fig.className = 'docs-code'
                    pre.parentNode?.insertBefore(fig, pre)
                    fig.appendChild(bar)
                    fig.appendChild(pre)
                })
        </script>
    </body>
</html>
