---
import { getSupportUi, getUi, localePath, type Locale } from '@/lib/i18n'
import { appUrl, socialDiscordUrl, socialXUrl } from '@/lib/siteLinks'

interface Props {
    locale?: Locale
}

const { locale = 'en' } = Astro.props
const year = new Date().getFullYear()
const copy = getUi(locale)
const support = getSupportUi(locale)

// The brand link above points at the landing page in the reader's language,
// so docs and the marketing site cross-link in both directions (#534).
const homeHref = locale === 'zh' ? `${appUrl}/zh/` : `${appUrl}/`

const links = [
    // The dashboard, not the first article. This was pointing at
    // getting-started from before /docs/ existed, and now that the top menu
    // carries no desktop links it is the only route back into the docs from a
    // page without a sidebar.
    { href: localePath(locale, '/docs/'), label: copy.docs },
    { href: localePath(locale, '/changelog'), label: copy.changelog },
    { href: localePath(locale, '/status'), label: copy.status },
    { href: localePath(locale, '/support'), label: support.supportNavLabel },
    { href: '/privacy', label: copy.privacy },
    { href: '/terms', label: copy.terms }
]
---

<footer class="docs-footer border-divider/60 bg-main border-t">
    <div
        class="mx-auto flex max-w-content flex-col items-start justify-between gap-5 px-[18px] pt-9 pb-10 min-[481px]:px-6 min-[721px]:px-8 sm:flex-row sm:items-center"
    >
        <div class="flex flex-wrap items-center gap-x-[18px] gap-y-2">
            <a
                href={homeHref}
                aria-label={copy.brand}
                class="text-fg inline-flex shrink-0 items-center gap-2 no-underline hover:no-underline"
            >
                <svg
                    class="docs-brand-mark"
                    viewBox="0 0 135 100"
                    aria-hidden="true"
                    focusable="false"
                >
                    <polygon points="10,80 35,15 47.5,15 22.5,80" fill="currentColor"></polygon>
                    <polygon points="35,15 60,80 47.5,15 72.5,80" fill="currentColor"></polygon>
                    <polygon points="60,80 85,15 72.5,80 97.5,15" fill="currentColor"></polygon>
                    <polygon points="85,15 110,80 97.5,15 122.5,80" fill="currentColor"></polygon>
                </svg>
                <span class="text-[1.0625rem] font-medium tracking-[-0.015em]"
                    >{copy.brandShort}</span
                >
                <span class="docs-brand-beta" aria-label="Beta">Beta</span>
            </a>
            <span
                class="text-subtle font-mono text-[0.75rem] tracking-[0.02em]"
                >© {year} Netmind</span
            >
        </div>
        <nav class="flex flex-wrap items-center gap-x-7 gap-y-2">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="text-fg/85 hover:text-fg text-ui no-underline transition-colors hover:no-underline"
                    >
                        {link.label}
                    </a>
                ))
            }
            {/* One cluster rather than two more entries on the end of the
                link list — the hairline and the wider gap are what say so.
                Unlike the header, the footer carries X as well: down here it
                is a follow, not a way to get unstuck. */}
            <span
                class="border-divider/60 ml-[-6px] flex items-center gap-0.5 border-l pl-5"
            >
                <a
                    href={socialXUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="docs-icon-btn docs-icon-bare"
                    aria-label={copy.followX}
                >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path>
                    </svg>
                </a>
                <a
                    href={socialDiscordUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="docs-icon-btn docs-icon-bare"
                    aria-label={copy.joinDiscord}
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path
                            d="M20.317 4.37a19.79 19.79 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037c-1.687.29-3.33.8-4.885 1.515a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.077.077 0 00.084-.028c.462-.63.874-1.296 1.227-1.995a.076.076 0 00-.015-.088.076.076 0 00-.027-.017 13.107 13.107 0 01-1.872-.893.077.077 0 01-.031-.098.078.078 0 01.023-.03 10.2 10.2 0 00.372-.29.075.075 0 01.077-.011c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.197.373.292a.076.076 0 01.03.065.078.078 0 01-.036.062c-.599.35-1.225.648-1.873.892a.077.077 0 00-.041.106c.36.698.772 1.363 1.225 1.994a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 00-.031-.03zM8.02 15.33c-1.182 0-2.157-1.086-2.157-2.419s.956-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"
                        ></path>
                    </svg>
                </a>
            </span>
        </nav>
    </div>
</footer>
