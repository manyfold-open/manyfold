---
import { ChevronDown, Moon, Search, Sun } from '@lucide/astro'
import {
    alternateLocalePath,
    getUi,
    languageOptions,
    localeOption,
    type Locale
} from '@/lib/i18n'
import { appUrl, socialDiscordUrl, socialGithubUrl } from '@/lib/siteLinks'

interface Props {
    locale?: Locale
    availableLocales?: Locale[]
}

const { locale = 'en', availableLocales } = Astro.props
const { pathname } = Astro.url
const copy = getUi(locale)
const languages = languageOptions
    .filter(
        (option) =>
            !availableLocales || availableLocales.includes(option.code)
    )
    .map((option) => ({
        ...option,
        href: alternateLocalePath(pathname, option.code),
        isCurrent: option.code === locale
    }))

// Land readers on the marketing page in the language they are reading (#534).
const homeHref = locale === 'zh' ? `${appUrl}/zh/` : `${appUrl}/`
// The changelog is a footer link now, and Footer.astro has carried one all
// along, so nothing needed adding there. It was already hidden on phones here,
// so this only changes the desktop menu.
// Empty at every width now. Navigation is the sidebar's job, and below the
// sidebar's breakpoint the sidebar is a drawer rather than nothing, so the one
// row left here has somewhere to go. That row was the API reference, kept only
// because `hidden lg:block` left a phone no route to it except search; it is a
// row of the tree in the drawer's Reference group, which is where the desktop
// entry point already was.
---

<header class="border-divider bg-main sticky top-0 z-30 border-b">
    {/* Geometry is the landing's, measured off .lp-nav-inner: the same
        1200px inner width, the same 16/32 padding, the same 4px inside the
        brand lockup and 6px between utilities. The two headers carry the same
        wordmark on adjacent surfaces and were starting at different x, at
        different sizes, with different gaps. Nothing is imported the other
        way: the docs keep their search field and their own CTA, and the
        landing's page links stay on the landing. */}
    <div
        class="mx-auto flex max-w-content items-center gap-3 px-[18px] py-4 min-[481px]:px-6 min-[721px]:px-8"
    >
        <a
            href={homeHref}
            aria-label={copy.brand}
            class="text-fg inline-flex shrink-0 items-center gap-1 no-underline hover:no-underline"
        >
            <svg
                class="docs-brand-mark"
                viewBox="0 0 135 100"
                aria-hidden="true"
                focusable="false"
            >
                <polygon points="10,80 35,15 47.5,15 22.5,80" fill="currentColor"></polygon>
                <polygon points="35,15 60,80 47.5,15 72.5,80" fill="currentColor"></polygon>
                <polygon points="60,80 85,15 72.5,80 97.5,15" fill="currentColor"></polygon>
                <polygon points="85,15 110,80 97.5,15 122.5,80" fill="currentColor"></polygon>
            </svg>
            <span
                class="hidden text-[1.1875rem] font-medium tracking-[-0.015em] sm:inline"
                >{copy.brandShort}</span
            >
            <span class="docs-brand-beta" aria-label="Beta">Beta</span>
        </a>

        <div class="ml-auto flex shrink-0 items-center gap-1.5">
            <button
                type="button"
                data-search-trigger
                class="docs-search-trigger w-9 justify-center sm:w-44 sm:justify-start"
                aria-label={copy.searchLabel}
            >
                <Search class="shrink-0" size={15} stroke-width={2} />
                <span class="hidden flex-1 truncate text-left sm:inline">{copy.searchPlaceholder}</span>
                <span class="docs-kbd hidden sm:inline">/</span>
            </button>

            {/* Docs readers are the people already mid-problem, so the two
                outward doors that belong up here are the source they are
                reading about and the room where humans answer — X is a
                marketing follow and stays in the footer. Hidden below md so
                the search field keeps its width. */}
            <a
                href={socialGithubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="docs-icon-btn docs-icon-bare hidden md:inline-flex"
                aria-label={copy.sourceGithub}
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                    <path
                        d="M12 0c6.63 0 12 5.276 12 11.79-.001 5.067-3.29 9.567-8.175 11.187-.6.118-.825-.25-.825-.56 0-.398.015-1.665.015-3.242 0-1.105-.375-1.813-.81-2.181 2.67-.295 5.475-1.297 5.475-5.822 0-1.297-.465-2.344-1.23-3.169.12-.295.54-1.503-.12-3.125 0 0-1.005-.324-3.3 1.209a11.32 11.32 0 00-3-.398c-1.02 0-2.04.133-3 .398-2.295-1.518-3.3-1.209-3.3-1.209-.66 1.622-.24 2.83-.12 3.125-.765.825-1.23 1.887-1.23 3.169 0 4.51 2.79 5.527 5.46 5.822-.345.294-.66.81-.765 1.577-.69.31-2.415.81-3.495-.973-.225-.354-.9-1.223-1.845-1.209-1.005.015-.405.56.015.781.51.28 1.095 1.327 1.23 1.666.24.663 1.02 1.93 4.035 1.385 0 .988.015 1.916.015 2.196 0 .31-.225.664-.825.56C3.303 21.374-.003 16.867 0 11.791 0 5.276 5.37 0 12 0z"
                    ></path>
                </svg>
            </a>
            <a
                href={socialDiscordUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="docs-icon-btn docs-icon-bare hidden md:inline-flex"
                aria-label={copy.joinDiscord}
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                        d="M20.317 4.37a19.79 19.79 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037c-1.687.29-3.33.8-4.885 1.515a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.077.077 0 00.084-.028c.462-.63.874-1.296 1.227-1.995a.076.076 0 00-.015-.088.076.076 0 00-.027-.017 13.107 13.107 0 01-1.872-.893.077.077 0 01-.031-.098.078.078 0 01.023-.03 10.2 10.2 0 00.372-.29.075.075 0 01.077-.011c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.197.373.292a.076.076 0 01.03.065.078.078 0 01-.036.062c-.599.35-1.225.648-1.873.892a.077.077 0 00-.041.106c.36.698.772 1.363 1.225 1.994a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 00-.031-.03zM8.02 15.33c-1.182 0-2.157-1.086-2.157-2.419s.956-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"
                    ></path>
                </svg>
            </a>

            {/* The same split the landing nav draws: what leaves the site on
                one side, what changes this page on the other. */}
            <span class="docs-nav-sep hidden md:block" aria-hidden="true"></span>

            {
                languages.length > 1 && (
                    <details class="group relative">
                        {/* The globe is dropped as duplicate — the code says
                            "language" by itself — and the chevron added so a
                            bare label still reads as a menu. */}
                        <summary
                            class="docs-icon-btn docs-icon-bare w-auto gap-[3px] px-2 [&::-webkit-details-marker]:hidden"
                            aria-label={copy.languageLabel}
                        >
                            <span class="docs-lang-code">
                                {localeOption(locale).code.toUpperCase()}
                            </span>
                            <ChevronDown
                                class="shrink-0 opacity-70"
                                size={11}
                                stroke-width={2.5}
                            />
                        </summary>
                        <div class="bg-surface-elevated shadow-elevated absolute right-0 z-20 mt-1.5 w-40 rounded-md p-1">
                            {languages.map((language) => (
                                <a
                                    href={language.href}
                                    dir={language.direction}
                                    class:list={[
                                        'block rounded-sm px-2.5 py-1.5 no-underline transition-colors hover:no-underline',
                                        language.isCurrent
                                            ? 'bg-soft font-medium text-fg'
                                            : 'text-muted hover:bg-soft hover:text-fg'
                                    ]}
                                    aria-current={
                                        language.isCurrent ? 'page' : undefined
                                    }
                                >
                                    {language.nativeName}
                                </a>
                            ))}
                        </div>
                    </details>
                )
            }

            <button
                type="button"
                data-theme-toggle
                class="docs-icon-btn docs-icon-bare"
                aria-label={copy.themeToggle}
                title={copy.themeToggle}
            >
                <Sun class="hidden dark:block" size={16} stroke-width={2} />
                <Moon class="block dark:hidden" size={16} stroke-width={2} />
            </button>

            {/* .lp-nav-cta's box: 38px tall, 18px of side padding, 13.5px
                label. The override under it was 34/16/13, so the two headers
                ended a row of otherwise matching controls on a button that
                was four pixels shorter here than on the page next door. */}
            <a
                href={homeHref}
                class="docs-button-primary hidden h-[38px] px-[18px] text-[0.84375rem] sm:inline-flex"
            >
                {copy.requestAccess}
            </a>
        </div>
    </div>
</header>

<script>
    const root = document.documentElement
    const apply = (theme: string) => {
        if (theme === 'dark') root.setAttribute('data-theme', 'dark')
        else root.removeAttribute('data-theme')
    }
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
            const next =
                root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
            apply(next)
            try {
                localStorage.setItem('mf-theme', next)
            } catch {
                /* ignore */
            }
        })
    )
</script>
