---
import {
    alternateLocalePath,
    getUi,
    languageOptions,
    localeOption,
    localePath,
    type Locale
} from '@/lib/i18n'
import { appUrl, socialDiscordUrl } from '@/lib/siteLinks'

interface Props {
    locale?: Locale
    availableLocales?: Locale[]
}

const { locale = 'en', availableLocales } = Astro.props
const { pathname } = Astro.url
const copy = getUi(locale)
const languages = languageOptions
    .filter(
        (option) =>
            !availableLocales || availableLocales.includes(option.code)
    )
    .map((option) => ({
        ...option,
        href: alternateLocalePath(pathname, option.code),
        isCurrent: option.code === locale
    }))

const docsHome = localePath(locale, '/docs/getting-started/')
// Land readers on the marketing page in the language they are reading (#534).
const homeHref = locale === 'zh' ? `${appUrl}/zh/` : `${appUrl}/`
const docsBase = localePath(locale, '/docs')
const links = [
    { href: docsHome, label: copy.docs, match: docsBase, hideOnMobile: false },
    {
        href: localePath(locale, '/api-reference'),
        label: copy.apiReference,
        hideOnMobile: false
    },
    {
        href: localePath(locale, '/changelog'),
        label: copy.changelog,
        hideOnMobile: true
    }
]
const isActive = (link: { href: string; match?: string }) =>
    pathname.startsWith(link.match ?? link.href)
---

<header class="border-divider bg-main sticky top-0 z-30 border-b">
    <div
        class="mx-auto flex max-w-content items-center gap-3 px-4 py-4 md:px-6"
    >
        <a
            href={homeHref}
            aria-label={copy.brand}
            class="text-fg inline-flex shrink-0 items-center gap-2 no-underline hover:no-underline"
        >
            <svg
                class="docs-brand-mark"
                viewBox="0 0 135 100"
                aria-hidden="true"
                focusable="false"
            >
                <polygon points="10,80 35,15 47.5,15 22.5,80" fill="currentColor"></polygon>
                <polygon points="35,15 60,80 47.5,15 72.5,80" fill="currentColor"></polygon>
                <polygon points="60,80 85,15 72.5,80 97.5,15" fill="currentColor"></polygon>
                <polygon points="85,15 110,80 97.5,15 122.5,80" fill="currentColor"></polygon>
            </svg>
            <span
                class="hidden text-[1.0625rem] font-medium tracking-[-0.015em] sm:inline"
                >{copy.brandShort}</span
            >
            <span class="docs-brand-beta" aria-label="Beta">Beta</span>
        </a>

        <nav class="text-ui flex min-w-0 items-center gap-0.5 font-medium sm:gap-1">
            {
                links.map((l) => (
                    <a
                        href={l.href}
                        class:list={[
                            'docs-nav-link',
                            l.hideOnMobile ? 'hidden md:inline' : '',
                            isActive(l) ? 'docs-nav-link-active' : ''
                        ]}
                    >
                        {l.label}
                    </a>
                ))
            }
        </nav>

        <div class="ml-auto flex shrink-0 items-center gap-2">
            <button
                type="button"
                data-search-trigger
                class="docs-search-trigger w-9 justify-center sm:w-44 sm:justify-start"
                aria-label={copy.searchLabel}
            >
                <svg
                    class="shrink-0"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
                <span class="hidden flex-1 truncate text-left sm:inline">{copy.searchPlaceholder}</span>
                <span class="docs-kbd hidden sm:inline">/</span>
            </button>

            {/* Docs readers are the people already mid-problem, so the one
                outward door that belongs up here is the room where humans
                answer — X is a marketing follow and stays in the footer.
                Hidden below md so the search field keeps its width. */}
            <a
                href={socialDiscordUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="docs-icon-btn docs-icon-bare hidden md:inline-flex"
                aria-label={copy.joinDiscord}
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                        d="M20.317 4.37a19.79 19.79 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037c-1.687.29-3.33.8-4.885 1.515a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.077.077 0 00.084-.028c.462-.63.874-1.296 1.227-1.995a.076.076 0 00-.015-.088.076.076 0 00-.027-.017 13.107 13.107 0 01-1.872-.893.077.077 0 01-.031-.098.078.078 0 01.023-.03 10.2 10.2 0 00.372-.29.075.075 0 01.077-.011c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.197.373.292a.076.076 0 01.03.065.078.078 0 01-.036.062c-.599.35-1.225.648-1.873.892a.077.077 0 00-.041.106c.36.698.772 1.363 1.225 1.994a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 00-.031-.03zM8.02 15.33c-1.182 0-2.157-1.086-2.157-2.419s.956-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"
                    ></path>
                </svg>
            </a>

            {
                languages.length > 1 && (
                    <details class="group relative">
                        {/* The globe is dropped as duplicate — the code says
                            "language" by itself — and the chevron added so a
                            bare label still reads as a menu. */}
                        <summary
                            class="docs-icon-btn docs-icon-bare w-auto gap-1 px-2 [&::-webkit-details-marker]:hidden"
                            aria-label={copy.languageLabel}
                        >
                            <span class="docs-lang-code">
                                {localeOption(locale).code.toUpperCase()}
                            </span>
                            <svg
                                class="shrink-0 opacity-70"
                                width="11"
                                height="11"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </summary>
                        <div class="bg-surface-elevated shadow-elevated absolute right-0 z-20 mt-1.5 w-40 rounded-md p-1">
                            {languages.map((language) => (
                                <a
                                    href={language.href}
                                    dir={language.direction}
                                    class:list={[
                                        'block rounded-sm px-2.5 py-1.5 no-underline transition-colors hover:no-underline',
                                        language.isCurrent
                                            ? 'bg-soft font-medium text-fg'
                                            : 'text-muted hover:bg-soft hover:text-fg'
                                    ]}
                                    aria-current={
                                        language.isCurrent ? 'page' : undefined
                                    }
                                >
                                    {language.nativeName}
                                </a>
                            ))}
                        </div>
                    </details>
                )
            }

            <button
                type="button"
                data-theme-toggle
                class="docs-icon-btn docs-icon-bare"
                aria-label={copy.themeToggle}
                title={copy.themeToggle}
            >
                <svg
                    class="hidden dark:block"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
                </svg>
                <svg
                    class="block dark:hidden"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
                </svg>
            </button>

            <a
                href={homeHref}
                class="docs-button-primary hidden h-8 px-3.5 text-ui sm:inline-flex"
            >
                {copy.requestAccess}
            </a>
        </div>
    </div>
</header>

<script>
    const root = document.documentElement
    const apply = (theme: string) => {
        if (theme === 'dark') root.setAttribute('data-theme', 'dark')
        else root.removeAttribute('data-theme')
    }
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
            const next =
                root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
            apply(next)
            try {
                localStorage.setItem('mf-theme', next)
            } catch {
                /* ignore */
            }
        })
    )
</script>
