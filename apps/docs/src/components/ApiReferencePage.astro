---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { codeToHtml } from 'shiki'
import {
    apiReferenceFor,
    endpointPath,
    methodClass
} from '@/lib/api-reference'
import { getUi, localePath, type Locale } from '@/lib/i18n'

interface Props {
    locale?: Locale
}

const { locale = 'en' } = Astro.props
const reference = apiReferenceFor(locale)
const ui = getUi(locale)
// The same three sections the deleted rail listed, in the same order.
const sections = [
    { id: 'quick-start', label: reference.quickStartTitle },
    { id: 'endpoints', label: reference.endpointsTitle },
    { id: 'errors', label: reference.errorsTitle }
]

const badge =
    'shrink-0 rounded-xs px-2 py-0.5 font-mono text-caption font-medium'

// Highlight the static examples with the same Shiki dual-theme the guides
// use (github-light / github-dark-dimmed, defaultColor:false), then keep
// only the inner <code> tokens so our own <pre data-language> wrapper — and
// the shared codebar/border enhancement — stay in charge of the chrome.
const highlight = async (code: string, lang: string): Promise<string> => {
    const html = await codeToHtml(code, {
        lang,
        themes: { light: 'github-light', dark: 'github-dark-dimmed' },
        defaultColor: false
    })
    return html
        .replace(/^[\s\S]*?<code[^>]*>/, '')
        .replace(/<\/code>[\s\S]*$/, '')
}

const ex = reference.examples
const hl = {
    chatRequest: await highlight(ex.chatRequest, 'bash'),
    chatResponse: await highlight(ex.chatResponse, 'json'),
    streamRequest: await highlight(ex.streamRequest, 'bash'),
    conversationsRequest: await highlight(ex.conversationsRequest, 'bash'),
    messagesRequest: await highlight(ex.messagesRequest, 'bash'),
    errorResponse: await highlight(ex.errorResponse, 'json')
}
import DocsSidebar from '@/components/DocsSidebar.astro'
import DocsPageToc from '@/components/DocsPageToc.astro'
import DocsPageActions from '@/components/DocsPageActions.astro'
import { filterDocsByLocale } from '@/lib/i18n'

const docsEntries = filterDocsByLocale(await getCollection('docs'), locale)

// The generated card, one route over. English only: Geist ships no CJK, so a
// Chinese card renders every Chinese character as a tofu box, verified by
// rendering one. The Chinese pages keep the shared static art.
const ogImage =
    locale === 'en'
        ? new URL('/api-reference.png', Astro.site).toString()
        : undefined

// This surface has a markdown twin now, so the Copy page control has a
// real endpoint to fetch rather than serialising the rendered page.
const mdHref = localePath(locale, '/api-reference.md')
const pageUrl = new URL(localePath(locale, '/api-reference'), Astro.site).toString()
---

<BaseLayout
    title={reference.title}
    description={reference.description}
    locale={locale}
    articleType="TechArticle"
    ogImage={ogImage}
>
    <!--
    Two columns, the same shape as the docs pages and the dashboard. Neither of
    these surfaces had a sidebar, so from either one there was no way back into
    the documentation tree except the top menu.
-->
<section
    class="docs-container docs-shell"
>
    {/* One sidebar, the documentation tree, with the reference and its
        endpoints as rows in the API group. This surface used to swap in a rail
        of its own, so walking into the reference replaced the whole tree and
        walking out replaced it back. */}
    <DocsSidebar entries={docsEntries} locale={locale} />

    <div class="min-w-0" data-copy-scope>
            <header class="docs-page-header flex items-start justify-between gap-6">
            <div class="min-w-0">
                <p class="docs-kicker">{reference.eyebrow}</p>
                <h1 class="mt-3 text-h1" id="page-title">
                    {reference.title}
                </h1>
                <p class="docs-copy mt-2 max-w-2xl">{reference.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                    <a href="#endpoints" class="docs-button-primary">
                        {reference.endpointsTitle}
                    </a>
                    <a
                        href={localePath(locale, '/docs/api-chat/')}
                        class="docs-button-secondary"
                    >
                        {reference.guideLinkLabel}
                    </a>
                </div>
            </div>
            <DocsPageActions locale={locale} mdHref={mdHref} pageUrl={pageUrl} />
            </header>

            <!-- Quick start -->
            {/* Stacked, not two-up. The 300px aside fitted while this surface
                had a content column of its own; in the shared 640 column it
                left the quick start 300px to run curl commands in. */}
            <div class="mt-10 grid gap-x-10 gap-y-6">
                <div class="min-w-0">
                    <h2 id="quick-start" class="scroll-mt-24 text-h2">
                        <a class="docs-heading-anchor" href="#quick-start" aria-label={ui.headingLink}></a>
                        {reference.quickStartTitle}
                    </h2>
                    <p class="mt-2 max-w-2xl text-ui text-muted">
                        {reference.quickStartLead}
                    </p>

                    <dl class="mt-4 grid gap-2.5 sm:grid-cols-2">
                        <div class="docs-cell sm:col-span-2">
                            <dt class="text-subtle text-caption uppercase tracking-[0.06em]">
                                {reference.baseUrlLabel}
                            </dt>
                            <dd class="mt-1 break-all font-mono text-ui text-fg">
                                https://api.manyfold.ai/api/v1
                            </dd>
                        </div>
                        <div class="docs-cell">
                            <dt class="text-subtle text-caption uppercase tracking-[0.06em]">
                                {reference.authLabel}
                            </dt>
                            <dd class="mt-1 break-all font-mono text-ui text-fg">
                                Authorization: Bearer
                            </dd>
                        </div>
                        <div class="docs-cell">
                            <dt class="text-subtle text-caption uppercase tracking-[0.06em]">
                                {reference.scopeLabel}
                            </dt>
                            <dd class="mt-1 break-all font-mono text-ui text-fg">
                                chat.completions
                            </dd>
                        </div>
                    </dl>

                    <ol class="docs-steps mt-5">
                        {
                            reference.quickStartSteps.map((step) => (
                                <li class="text-ui text-fg">{step}</li>
                            ))
                        }
                    </ol>
                </div>

                <aside class="docs-block self-start">
                    <h2 class="text-h3">{reference.tokensTitle}</h2>
                    <p class="mt-2 text-ui text-muted">{reference.tokensLead}</p>
                </aside>
            </div>

            <!-- Endpoints overview -->
            <div class="mt-12">
                <h2 id="endpoints" class="scroll-mt-24 text-h2">
                    <a class="docs-heading-anchor" href="#endpoints" aria-label={ui.headingLink}></a>
                    {reference.endpointsTitle}
                </h2>
                <p class="mt-2 max-w-2xl text-ui text-muted">{reference.endpointsLead}</p>
            </div>

            <!-- Endpoint detail -->
            {/* Summary cards, not the full endpoint bodies. Each endpoint has
                its own page now, so repeating parameters and examples here
                would give two URLs the same content. The card keeps the id the
                single-page version published, so a link to
                /api-reference#chat-completions still lands on the right row
                and one click reaches the detail. Anchors cannot be redirected
                server side, which is why the id has to survive here. */}
            <div class="mt-6 space-y-3">
                {
                    reference.endpoints.map((endpoint) => (
                        <a
                            id={endpoint.id}
                            href={endpointPath(locale, endpoint.id)}
                            class="docs-block scroll-mt-24 block no-underline hover:no-underline"
                        >
                            <div class="flex flex-wrap items-center gap-2">
                                <span class:list={[badge, methodClass(endpoint.method)]}>
                                    {endpoint.method}
                                </span>
                                <code class="font-mono text-ui text-fg">
                                    {endpoint.path}
                                </code>
                            </div>
                            <p class="text-fg mt-2 font-medium">{endpoint.title}</p>
                            <p class="mt-1 max-w-2xl text-ui text-muted">
                                {endpoint.description}
                            </p>
                        </a>
                    ))
                }
            </div>

                {/* The request and response examples moved to the endpoint
                    pages they belong to. Keeping them here as well would have
                    put the same curl command on two URLs, which is the thing
                    splitting the reference was meant to stop. The error shape
                    below stays, because it is shared by every endpoint. */}

                <div class="mt-12 max-w-2xl">
                    <h2 id="errors" class="scroll-mt-24 text-h2">
                        <a class="docs-heading-anchor" href="#errors" aria-label={ui.headingLink}></a>
                        {reference.errorsTitle}
                    </h2>
                    <p class="mt-2 text-ui text-muted">{reference.errorsLead}</p>
                    <pre class="docs-pre" data-language="json"><code set:html={hl.errorResponse} /></pre>
                    <p class="mt-4 text-ui text-muted">
                        <a href={localePath(locale, '/docs/api-chat/')}>
                            {reference.guideLinkLabel}
                        </a>
                        {' · '}
                        <a href={localePath(locale, '/docs/api-conversations/')}>
                            {reference.conversationsGuideLinkLabel}
                        </a>
                    </p>
                </div>
            </div>
    </div>

    {sections.length > 1 && (
        <DocsPageToc locale={locale} sections={sections} />
    )}
</section>
</BaseLayout>
