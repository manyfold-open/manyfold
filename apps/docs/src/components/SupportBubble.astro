---
import SupportChat from '@/components/SupportChat.astro'
import { getSupportUi, type Locale } from '@/lib/i18n'

interface Props {
    locale?: Locale
}

const { locale = 'en' } = Astro.props
const copy = getSupportUi(locale)
---

<button
    type="button"
    class="docs-support-launcher"
    data-support-launcher
    aria-expanded="false"
    aria-controls="docs-support-panel"
    aria-label={copy.bubbleOpen}
>
    <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M21 12a8 8 0 0 1-8 8H8l-4 3v-4.6A8 8 0 0 1 13 4a8 8 0 0 1 8 8Z"></path>
        <path d="M9.6 9.6a2.4 2.4 0 0 1 4.7.6c0 1.6-2.3 2-2.3 3.4"></path>
        <path d="M12 17h.01"></path>
    </svg>
</button>

<div
    class="docs-support-panel"
    id="docs-support-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="docs-support-panel-title"
    hidden
>
    <div class="docs-support-head">
        <div>
            <p class="docs-support-heading" id="docs-support-panel-title">
                {copy.panelTitle}
            </p>
            <p class="docs-support-sub">{copy.panelSubtitle}</p>
        </div>
        <button
            type="button"
            class="docs-icon-btn"
            data-support-close
            aria-label={copy.bubbleClose}
        >
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
        </button>
    </div>
    <SupportChat locale={locale} variant="bubble" />
</div>

<script>
    const OPEN_KEY = 'mf-support-open'
    const launcher = document.querySelector<HTMLElement>('[data-support-launcher]')
    const panel = document.getElementById('docs-support-panel')

    if (launcher && panel) {
        let loaded = false

        const focusables = (): HTMLElement[] =>
            Array.from(
                panel.querySelectorAll<HTMLElement>(
                    'a[href], button:not([disabled]), textarea:not([disabled])'
                )
            ).filter((el) => !el.hidden && el.offsetParent !== null)

        const remember = (open: boolean) => {
            try {
                if (open) sessionStorage.setItem(OPEN_KEY, '1')
                else sessionStorage.removeItem(OPEN_KEY)
            } catch {
                /* storage unavailable */
            }
        }

        const open = async (focus = true) => {
            panel.removeAttribute('hidden')
            panel.classList.add('is-open')
            launcher.setAttribute('aria-expanded', 'true')
            document.body.classList.add('is-support-open')
            remember(true)
            if (!loaded) {
                loaded = true
                const chat = await import('@/lib/support/chat')
                chat.mountSupportChat()
            }
            if (focus)
                panel
                    .querySelector<HTMLTextAreaElement>('[data-support-input]')
                    ?.focus()
        }

        const close = () => {
            panel.classList.remove('is-open')
            panel.setAttribute('hidden', '')
            launcher.setAttribute('aria-expanded', 'false')
            document.body.classList.remove('is-support-open')
            remember(false)
            launcher.focus()
        }

        launcher.addEventListener('click', () => {
            if (panel.hasAttribute('hidden')) void open()
            else close()
        })

        panel
            .querySelector('[data-support-close]')
            ?.addEventListener('click', close)

        document.addEventListener('keydown', (event) => {
            if (panel.hasAttribute('hidden')) return
            if (event.key === 'Escape') {
                close()
                return
            }
            if (event.key !== 'Tab') return
            const items = focusables()
            if (!items.length) return
            const first = items[0]
            const last = items[items.length - 1]
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault()
                first.focus()
            }
        })

        // A navigation kills any in-flight stream; reopening here is what makes
        // the finished answer show up again on the next page.
        try {
            if (sessionStorage.getItem(OPEN_KEY) === '1') void open(false)
        } catch {
            /* storage unavailable */
        }
    }
</script>