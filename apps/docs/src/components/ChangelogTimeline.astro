---
import { getCollection, render } from 'astro:content'
import { getUi, type Locale } from '@/lib/i18n'

interface Props {
    locale?: Locale
}

const { locale = 'en' } = Astro.props
const copy = getUi(locale)

const versionParts = (version: string) =>
    version.split('.').map((part) => Number.parseInt(part, 10) || 0)
const compareVersions = (a: string, b: string) => {
    const aParts = versionParts(a)
    const bParts = versionParts(b)
    for (let i = 0; i < Math.max(aParts.length, bParts.length); i += 1) {
        const diff = (bParts[i] ?? 0) - (aParts[i] ?? 0)
        if (diff !== 0) return diff
    }
    return 0
}
const entries = (await getCollection('changelog')).sort(
    (a, b) =>
        b.data.date.localeCompare(a.data.date) ||
        compareVersions(a.data.version, b.data.version)
)
const rendered = await Promise.all(
    entries.map(async (e) => ({ data: e.data, ...(await render(e)) }))
)
---

<section class="docs-container docs-page-section">
    <header class="docs-page-header">
        <p class="docs-kicker">{copy.brandShort}</p>
        <h1 class="mt-3 text-h1">{copy.changelogTitle}</h1>
        <p class="docs-copy mt-2">{copy.changelogLead}</p>
    </header>

    <div class="mt-6 max-w-xl">
        <input
            id="changelog-filter"
            type="search"
            class="docs-search-trigger h-10 w-full cursor-text justify-start text-body"
            placeholder={copy.changelogFilter}
            autocomplete="off"
        />
    </div>

    <div id="changelog-list" class="docs-timeline mt-7">
        {
            rendered.map(({ data, Content }) => (
                <article
                    id={`v${data.version}`}
                    class="docs-timeline-entry mb-8"
                    data-changelog-entry
                >
                    <div class="flex flex-wrap items-center gap-2.5">
                        <span class="bg-info-bg text-info-strong rounded-xs px-2 py-0.5 font-mono text-caption font-medium">
                            v{data.version}
                        </span>
                        <time class="text-ui text-subtle" datetime={data.date}>
                            {data.date}
                        </time>
                    </div>
                    <div class="prose-doc mt-3">
                        <Content />
                    </div>
                </article>
            ))
        }
    </div>

    <p id="changelog-none" class="text-ui text-muted mt-6 hidden">
        {copy.changelogNoMatch}
    </p>
</section>

<script>
    const filter = document.getElementById(
        'changelog-filter'
    ) as HTMLInputElement | null
    const none = document.getElementById('changelog-none')
    const items = Array.from(
        document.querySelectorAll<HTMLElement>('[data-changelog-entry]')
    )

    filter?.addEventListener('input', () => {
        const q = filter.value.toLowerCase().trim()
        let shown = 0
        items.forEach((item) => {
            const hit = item.textContent?.toLowerCase().includes(q) ?? false
            item.hidden = !hit
            if (hit) shown += 1
        })
        none?.classList.toggle('hidden', shown > 0)
    })
</script>
