---
// Copy page, plus the .md twin and the two LLM hand-offs. Extracted out of
// DocArticle so /api-reference and /changelog get the same control: they are
// the two surfaces an agent is most likely to want in markdown, and both had
// no way to reach their twin.
//
// Copy fetches the twin rather than serialising the DOM, so what lands on the
// clipboard is authored markdown, not a reconstruction of the rendered page.
import { getUi, type Locale } from '@/lib/i18n'

interface Props {
    locale: Locale
    mdHref: string
    pageUrl: string
}

const { locale, mdHref, pageUrl } = Astro.props
const copy = getUi(locale)
const llmPrompt = `Read ${pageUrl} and ask questions about it.`
---

<div
    class="docs-page-actions"
    data-page-actions
    data-md={mdHref}
    data-copied={copy.copied}
>
    <button type="button" class="docs-pa-main" data-copy-page>
        <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="5.5" y="2.5" width="8" height="10" rx="1.5" />
            <path d="M3.5 10.2V4a1.5 1.5 0 0 1 1.5-1.5h4.7" />
        </svg>
        <span data-copy-label>{copy.copyPage}</span>
    </button>
    <button
        type="button"
        class="docs-pa-toggle"
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label={copy.morePageActions}
        data-pa-toggle
    >
        <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M3 4.5 6 7.5 9 4.5" />
        </svg>
    </button>
    <div class="docs-pa-menu" role="menu" hidden data-pa-menu>
        <a role="menuitem" href={mdHref} target="_blank" rel="noopener">
            {copy.viewAsMarkdown}
        </a>
        <a
            role="menuitem"
            href={`https://chatgpt.com/?hints=search&q=${encodeURIComponent(llmPrompt)}`}
            target="_blank"
            rel="noopener"
        >
            {copy.openInChatGpt}
        </a>
        <a
            role="menuitem"
            href={`https://claude.ai/new?q=${encodeURIComponent(llmPrompt)}`}
            target="_blank"
            rel="noopener"
        >
            {copy.openInClaude}
        </a>
    </div>
</div>
